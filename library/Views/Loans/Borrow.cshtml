
@model BorrowForm

@{
    ViewData["Title"] = "Borrow a book";
}

<div class="p-3 mb-3 rounded bg-success text-white shadow-sm">
    <h1 class="mb-0">New Book Borrowing</h1>
    <small>Complete the information below.</small>
</div>

<form asp-action="Borrow"
      method="post"
      class="card card-body shadow-sm border-0"
      style="max-width: 36rem;">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="MemberId" class="form-label fw-semibold">
            Member
        </label>

        <select asp-for="MemberId"
                asp-items="ViewBag.Members"
                class="form-select">
            <option value="">(choose a member)</option>
        </select>

        <span asp-validation-for="MemberId"
              class="text-danger small">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="BookId" class="form-label fw-semibold">
            Book
        </label>

        <select asp-for="BookId"
                asp-items="ViewBag.Books"
                class="form-select">
            <option value="">(choose a book)</option>
        </select>

        <span asp-validation-for="BookId"
              class="text-danger small">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="DaysAllowed" class="form-label fw-semibold">
            Days allowed
        </label>

        <input asp-for="DaysAllowed"
               class="form-control" />

        <span asp-validation-for="DaysAllowed"
              class="text-danger small">
        </span>
    </div>

    <div class="d-flex gap-2 mt-2">
        <button type="submit" class="btn btn-success">
            Borrow Book
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

