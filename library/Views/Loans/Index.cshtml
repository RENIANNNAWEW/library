
@model List<LoanView>

@{
    ViewData["Title"] = "Loans";
}

    <div class="p-4 mb-4 rounded-3 shadow-sm" style="background-color: #F3E5D0; color: #5C4033;">
    <h1 class="mb-2">Library Loans</h1>
    <p class="mb-0">
        Manage borrowed books and monitor their return status.
    </p>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Loan Records (@Model.Count)</h4>

    <a asp-action="Borrow" class="btn btn-success">
        + Borrow a Book
    </a>
</div>

<table class="table table-hover table-bordered align-middle shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Member</th>
            <th>Book</th>
            <th>Loaned</th>
            <th>Due</th>
            <th>Status</th>
            <th style="width: 7rem;"></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.MemberName</td>
                <td>@loan.BookTitle</td>
                <td>@loan.LoanedOn.ToString("yyyy-MM-dd")</td>
                <td>@loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd")</td>

                <td>
                    <span class="badge @(loan.Status == "Overdue" ? "text-bg-danger" : loan.Status == "Out" ? "text-bg-warning" : "text-bg-secondary")">
                        @loan.Status
                    </span>
                </td>

                <td class="text-end">
                    @if (loan.ReturnedOn == null)
                    {
                        <form asp-action="Return"
                              asp-route-id="@loan.LoanId"
                              method="post"
                              class="d-inline">

                            <button type="submit" class="btn btn-sm btn-outline-success">
                                Return
                            </button>

                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <div class="alert alert-info text-center mt-3">
        No loan records found. Click "Borrow a Book" to create your first loan.
    </div>
}
