
@model library.Models.Member

@{
    ViewData["Title"] = "Delete Member";
}

<div class="p-4 mb-4 rounded-3 bg-danger text-white shadow-sm">
    <h1 class="mb-1">Delete Member</h1>
    <p class="mb-0">Review the member information before deleting.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger shadow-sm">
        <strong>Unable to Delete Member!</strong>
        <p class="mb-0">@ViewBag.Error</p>
    </div>
}

<div class="card shadow-sm border-0 mb-4" style="max-width: 36rem;">
    <div class="card-body">
        <h5 class="card-title mb-3">Member Information</h5>

        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@(Model.Email ?? "—")</dd>

            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@Model.MemberType</dd>
        </dl>
    </div>
</div>

<div class="alert alert-warning shadow-sm" style="max-width: 36rem;">
    <strong>Are you sure?</strong>
    <p class="mb-0">
        You are about to delete this member. This action cannot be undone.
    </p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.MemberId" />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>
