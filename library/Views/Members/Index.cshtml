@model List<library.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <p class="card-label mb-1">LIBRARY DIRECTORY</p>
        <h1 class="mt-0 mb-1">Our Members</h1>
        <p class="text-muted mb-0">Manage your library community.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add a member
    </a>
</div>

<div class="mb-3">
    <span class="badge rounded-pill text-bg-light border">
        Total members: @Model.Count
    </span>
</div>

<div class="row g-3">
    @foreach (var member in Model)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="library-card">
                <p class="card-label mb-2">MEMBER #@member.MemberId</p>

                <h5 class="card-value mb-3">@member.FullName</h5>

                <p class="mb-2">
                    <span class="card-label">Email</span><br />
                    @(member.Email ?? "—")
                </p>

                <p class="mb-3">
                    <span class="card-label">Membership type</span><br />
                    <span class="badge rounded-pill text-bg-light border">
                        @member.MemberType
                    </span>
                </p>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Edit"
                       asp-route-id="@member.MemberId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@member.MemberId"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Count == 0)
{
    <div class="library-card text-center mt-3">
        <h3>No members yet</h3>
        <p>Start building your library community by adding a member.</p>
        <a asp-action="Create" class="btn btn-primary">Add a member</a>
    </div>
}